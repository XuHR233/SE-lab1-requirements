@startuml
' 实验二 · 二手交易系统 · 订单状态图（课堂版：7 个状态 + 关键迁移）
' 锁货、退款放货、超时规则、商品状态联动等细节写在报告中，图内不展开
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 40
skinparam state {
  BackgroundColor #F7FBF7
  BorderColor #4B7A5E
}

state "待付款" as O1
state "待发货" as O2
state "待收货" as O3
state "已完成" as O4
state "已取消" as O5
state "已退款" as O6
state "纠纷中" as O7

[*] --> O1 : 普通商品下单
[*] --> O2 : 预售尾款支付成功

O1 --> O2 : 支付成功
O1 --> O5 : 买家/卖家取消或超时

O2 --> O3 : 卖家发货
O2 --> O6 : 未发货退款
O2 --> O7 : 客服介入

O3 --> O4 : 确认收货\n或按订单类型自动确认
O3 --> O7 : 客服介入

O7 --> O2 : 继续履约（未发货）
O7 --> O3 : 继续履约（已发货）
O7 --> O6 : 裁定退款

O4 --> [*]
O5 --> [*]
O6 --> [*]

@enduml
