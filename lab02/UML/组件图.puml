@startuml
' 实验二 · 二手交易系统 · 组件图（模块划分与模块交互）
' 画法取舍：职责写进模块框内，不再用大块便签解释；跨模块交互压成底部图注。
' 版心约束：报告 A4 版心 16cm，图越宽字越小（12px 字号在 1920px 宽图上打印只有 1.0mm）。
'           故模块标签压到 2 行、图注拆短行，把画布宽度收到 ~1100px，字高约 1.7mm 可读。
' 口径变更：旧「退款下架」改为「退款释放、按类型恢复原销售状态」；
'           新增预约锁货/释放交互（提交预约即锁货，取消/拒绝/过期放货）。
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam nodesep 14
skinparam ranksep 30
skinparam padding 8
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #F4F8FF
  BorderColor #4A6FA5
}
skinparam packageBackgroundColor #FAFCFE
skinparam packageBorderColor #9BB2C8
skinparam databaseBackgroundColor #FFF6E5

component "Web 前端\n买家 · 卖家 · 管理三端" as FE
component "API 网关\n身份校验 · 限流 · 幂等" as GW

package "业务模块层（单体后端）" as BIZ {
  component "M1 账号与权限\n注册登录 · 角色 · 会话" as M1
  component "M2 商品中心\n发布审核 · 状态机 · 检索" as M2
  component "M3 预售预约\n预约状态 · 确认 · 到货" as M3
  component "M4 交易与资金\n订单 · 托管支付 · 退款" as M4
  component "M5 沟通与纠纷\n会话消息 · 纠纷工单" as M5
  component "M6 评价与统计\n双方互评 · 卖家统计" as M6
  component "M7 日志与运维\n操作日志 · 备份恢复" as M7
}

component "数据访问层\n本地事务 · 唯一约束" as DAO
database "MySQL 主库" as DB
component "支付宝 / 微信\n担保托管" as PAY
component "对象存储\n商品图片" as OSS
component "短信通知\n到货 · 履约提醒" as SMS
component "定时调度\n只触发 · 不拥有业务规则" as SCHED

' ———— 分层调用 ————
FE --> GW : HTTPS / JSON

GW --> M1 : 身份/权限校验
GW --> M2
GW --> M3
GW --> M4
GW --> M5
GW --> M6
GW --> M7

BIZ --> DAO : 统一持久化
DAO -right-> DB : 读写
M4 <--> PAY : 支付 / 退款 / 回调
M2 --> OSS : 图片
M3 --> SMS : 到货提醒
M4 --> SMS : 履约提醒
SCHED -down-> BIZ : 到点触发 M3 / M4 / M6 / M7

note bottom of BIZ
  <b>跨模块调用（状态由拥有者修改）</b>
  M4 → M2 下单时请求锁货（已发布→待付款锁定）
  M4 → M2 支付成功转交易中 / 取消超时放货回已发布
  M3 → M2 预约前校验已预售且无有效预约
  M3 → M2 提交预约即请求锁货、放货时恢复已预售可见
  M3 → M4 发起定金/尾款/退款
  M4 → M3 回传支付结果
  M4 → M2 订单完成转已售出
  M4 → M2 未发货全额退款释放，按类型恢复已发布/已预售
  M2 → M3 请求取消有效预约
  M5 → M2/M4 验商品/查单/申请退款
  M4 → M6 订单完成开放评价
  M1~M6 → M7 统一记日志
end note

@enduml
